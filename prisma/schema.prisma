generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  passwordHash       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  teacherId          String?
  sentNotifications  Notification[]       @relation("SentNotifications")
  reports            Report[]
  grades             Grade[]
  roles              UserRole[]
  approvedApprovals  ResultApproval[]     @relation("ApprovedApprovals")
  rejectedApprovals  ResultApproval[]     @relation("RejectedApprovals")
  submittedApprovals ResultApproval[]     @relation("SubmittedApprovals")
  auditLogs          ResultAuditLog[]     @relation("AuditLogs")
  teacherActivities  TeacherActivityLog[] @relation("TeacherActivities")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  key   String           @unique
  label String?
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Department {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  classes       Class[]
  notifications Notification[]
  subjects      Subject[]
}

model Class {
  id                Int                  @id @default(autoincrement())
  name              String
  departmentId      Int
  level             String?
  sort_order        Int?
  department        Department           @relation(fields: [departmentId], references: [id])
  grades            Grade[]
  notifications     Notification[]
  results           Result[]
  students          Student[]
  subjects          Subject[]
  auditLogs         ResultAuditLog[]
  teacherActivities TeacherActivityLog[] @relation("TeacherActivityClass")

  @@unique([name, departmentId])
}

model Subject {
  id           Int              @id @default(autoincrement())
  name         String
  departmentId Int?
  classId      Int?
  maxScore     Float            @default(100.0)
  section      String?
  grades       Grade[]
  reports      Report[]
  class        Class?           @relation(fields: [classId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  auditLogs    ResultAuditLog[]

  @@unique([name, departmentId])
}

model Term {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  grades    Grade[]
  reports   Report[]
  results   Result[]
  auditLogs ResultAuditLog[]
}

model Session {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  isActive  Boolean          @default(false)
  grades    Grade[]
  results   Result[]
  students  Student[]
  auditLogs ResultAuditLog[] @relation("AcademicSessionAudit")
}

model Student {
  id          String           @id @default(cuid())
  admissionNo String           @unique
  firstName   String
  lastName    String
  middleName  String?
  sex         String?
  birthDate   DateTime?
  classId     Int
  sessionId   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  grades      Grade[]
  reports     Report[]
  results     Result[]
  class       Class            @relation(fields: [classId], references: [id])
  session     Session          @relation(fields: [sessionId], references: [id])
  parents     StudentParent[]
  auditLogs   ResultAuditLog[]
}

model Parent {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  phone                  String?
  passwordHash           String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  notificationRecipients NotificationRecipient[]
  students               StudentParent[]
}

model StudentParent {
  studentId String
  parentId  String
  relation  String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  subjectId   Int
  classId     Int
  termId      Int
  sessionId   Int
  teacherId   String?
  firstScore  Float?
  secondScore Float?
  fourthScore Float?
  average     Float
  gradeId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id])
  session     Session  @relation(fields: [sessionId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])
  term        Term     @relation(fields: [termId], references: [id])
  teacher     User?    @relation(fields: [teacherId], references: [id])

  @@unique([studentId, subjectId, classId, termId, sessionId])
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  classId    Int
  termId     Int
  sessionId  Int
  position   Int?
  average    Float
  totalScore Float
  maxScore   Float
  gradeId    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  class      Class    @relation(fields: [classId], references: [id])
  session    Session  @relation(fields: [sessionId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])
  term       Term     @relation(fields: [termId], references: [id])

  @@unique([studentId, classId, termId, sessionId])
}

model GradeScale {
  id          Int     @id @default(autoincrement())
  grade       String  @unique
  minScore    Float
  maxScore    Float
  description String?
}

model Report {
  id         String       @id @default(cuid())
  studentId  String
  teacherId  String
  subjectId  Int?
  termId     Int
  grade      String
  comment    String
  attendance Int?
  conduct    String?
  status     ReportStatus @default(DRAFT)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  student    Student      @relation(fields: [studentId], references: [id])
  subject    Subject?     @relation(fields: [subjectId], references: [id])
  teacher    User         @relation(fields: [teacherId], references: [id])
  term       Term         @relation(fields: [termId], references: [id])

  @@index([studentId, termId])
}

model Notification {
  id            String                  @id @default(cuid())
  senderId      String
  title         String
  message       String
  type          NotificationType
  priority      Priority                @default(NORMAL)
  recipientType RecipientType
  classId       Int?
  departmentId  Int?
  sentAt        DateTime                @default(now())
  class         Class?                  @relation(fields: [classId], references: [id])
  department    Department?             @relation(fields: [departmentId], references: [id])
  sender        User                    @relation("SentNotifications", fields: [senderId], references: [id])
  recipients    NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  parentId       String
  read           Boolean      @default(false)
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id])
  parent         Parent       @relation(fields: [parentId], references: [id])

  @@unique([notificationId, parentId])
}

model ResultAuditLog {
  id                String   @id @default(cuid())
  entityType        String
  entityId          String
  action            String
  oldValues         Json?
  newValues         Json
  changedFields     String[]
  userId            String
  userName          String
  userEmail         String
  userRole          String
  sessionId         String
  ipAddress         String
  userAgent         String?
  classId           Int?
  studentId         String?
  subjectId         Int?
  termId            Int?
  sessionIdAcademic Int?
  timestamp         DateTime @default(now())
  source            String   @default("WEB")
  batchId           String?
  notes             String?
  teacherFullName   String?
  teacherId         String?
  class             Class?   @relation(fields: [classId], references: [id])
  academicSession   Session? @relation("AcademicSessionAudit", fields: [sessionIdAcademic], references: [id])
  student           Student? @relation(fields: [studentId], references: [id])
  subject           Subject? @relation(fields: [subjectId], references: [id])
  term              Term?    @relation(fields: [termId], references: [id])
  user              User     @relation("AuditLogs", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, timestamp])
  @@index([classId, timestamp])
  @@index([studentId, timestamp])
  @@index([teacherId, timestamp])
  @@index([timestamp])
  @@map("result_audit_logs")
}

model TeacherActivityLog {
  id                String   @id @default(cuid())
  userId            String
  action            String
  resourceType      String
  resourceId        String?
  details           Json?
  duration          Int?
  recordsAffected   Int?
  ipAddress         String
  userAgent         String?
  sessionId         String
  classId           Int?
  termId            Int?
  sessionIdAcademic Int?
  timestamp         DateTime @default(now())
  teacherFullName   String?
  teacherId         String?
  class             Class?   @relation("TeacherActivityClass", fields: [classId], references: [id])
  user              User     @relation("TeacherActivities", fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([classId, timestamp])
  @@index([teacherId, timestamp])
  @@map("teacher_activity_logs")
}

model ResultApproval {
  id                     String    @id @default(cuid())
  entityType             String
  entityId               String
  entityTypeFull         String
  submittedBy            String
  submittedAt            DateTime  @default(now())
  approvedBy             String?
  approvedAt             DateTime?
  rejectedBy             String?
  rejectedAt             DateTime?
  rejectionReason        String?
  status                 String    @default("PENDING")
  classId                Int?
  studentId              String?
  termId                 Int?
  sessionIdAcademic      Int?
  submitterNotes         String?
  approverNotes          String?
  approvedByTeacherId    String?
  approvedByTeacherName  String?
  rejectedByTeacherId    String?
  rejectedByTeacherName  String?
  submittedByTeacherId   String?
  submittedByTeacherName String?
  approver               User?     @relation("ApprovedApprovals", fields: [approvedBy], references: [id])
  rejecter               User?     @relation("RejectedApprovals", fields: [rejectedBy], references: [id])
  submitter              User      @relation("SubmittedApprovals", fields: [submittedBy], references: [id])

  @@index([status, submittedAt])
  @@index([submittedBy, submittedAt])
  @@index([classId, status])
  @@index([submittedByTeacherId, submittedAt])
  @@map("result_approvals")
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

enum NotificationType {
  ANNOUNCEMENT
  REPORT_READY
  MEETING
  REMINDER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RecipientType {
  ALL_PARENTS
  CLASS_PARENTS
  DEPARTMENT_PARENTS
  SPECIFIC_PARENTS
}
