    "@mui/material": "^7.3.7",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sanity/client": "^7.14.0",
    "@sanity/image-url": "^2.0.2",
    "@sanity/vision": "^5.3.1",
    "@tanstack/react-table": "^8.21.3",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "next-sanity": "^12.0.12",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "puppeteer": "^24.36.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
